// © ChartPrime
// Modified for Scalping (M1/M5/M15) - Optimized for XAU & Forex
//
// ⚠️ CRITICAL MULTI-TIMEFRAME RULES (MUST READ):
// ==================================================
// 🎯 THE GOLDEN RULE: "M15 DECIDES, M5 EXECUTES"
//
// ❌ NEVER trade M5 diamonds alone - 70% are FAKE!
// ✅ ALWAYS check M15 first - this is where institutions operate
//
// 📊 PROPER TRADING WORKFLOW:
// 1. START on M15 → Find diamond at S/R (this is your BIAS)
// 2. SWITCH to M5 → Wait for retest of M15 level (this is your ENTRY)
// 3. EXECUTE on M5 → Enter on rejection candle with tight stop
//
// 🔍 WHY THIS WORKS:
// • M15 diamonds = Institutional levels (banks, funds)
// • M5 diamonds alone = Retail noise (stop hunts, fakeouts)
// • M15 structure + M5 entry = Professional edge
//
// ⏰ TIMING RULES:
// • Best entries: Within 30-45 min of M15 diamond
// • After 1 hour: Level often exhausted, skip
// • First retest: Highest win rate
// • Third retest: Usually breaks
//
// 📊 TRADING STRATEGIES:
// 1. FIRST TOUCH: Price touches S/R → diamond (◆) appears → rejection candle → ENTER
// 2. BREAK & RETEST: See "SBR/RBS ⚠" label → wait for pullback → diamond (◆) at retest → ENTER
//    - RBS: Resistance broken → becomes support → BUY on retest (green ◆ below)
//    - SBR: Support broken → becomes resistance → SELL on retest (red ◆ above)
// 3. CONFLUENCE: Best entries when diamond + candlestick pattern + volume confirmation align
//
// 💎 ENTRY SIGNALS:
// - Green ◆ below candle = BUY signal (support holds or broken resistance retested)
// - Red ◆ above candle = SELL signal (resistance holds or broken support retested)
//
// 🟠 ZONE FLIP (SBR/RBS):
// - Orange zone with "SBR ⚠" = Support Became Resistance (zone flipped - be careful!)
// - Orange zone with "RBS ⚠" = Resistance Became Support (zone flipped - wait for retest)
//
// 📈 SIMPLE EXECUTION CHECKLIST:
// ☐ M15 diamond appeared? (Your reason to trade)
// ☐ Price returned to level on M5? (Your entry zone)
// ☐ Rejection candle formed? (Your trigger)
// ☐ Risk:Reward > 1:2? (Your edge)
// If all ✓ → EXECUTE. If any ✗ → SKIP.
//
// 📏 RISK MANAGEMENT:
// - Stop Loss: Beyond box edge + 5-10 pip buffer
// - Take Profit: Next S/R zone OR minimum 1:2 RR
// - Avoid trading during major news events (NFP, FOMC, CPI)

//@version=5
indicator("SR Fast - AGGRESSIVE Scalping 7,2,1 [Custom]", shorttitle = "SR Fast 7,2,1", overlay=true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)


// ---------------------------------------------------------------------------------------------------------------------}
// 𝙐𝙎𝙀𝙍 𝙄𝙉𝙋𝙐𝙏𝙎
// ---------------------------------------------------------------------------------------------------------------------{

// AUTO TIMEFRAME DETECTION
bool autoSettings = input.bool(true, "🔄 Auto-Adjust Settings by Timeframe", group = "Settings",
      tooltip = "✅ AUTO MODE (Aggressive Scalping)\n\n📊 Automatic settings per timeframe:\n• M1: 5,2,0.6 (Ultra-fast scalping)\n• M5: 7,2,1.0 (Fast scalping - YOUR SWEET SPOT)\n• M15: 8,2,1.0 (Quick trades)\n• M30: 10,3,1.2 (Balanced)\n• H1+: 15,4,1.5 (Position)\n\n🟨 Gold/XAU: +20% wider zones\n\nToggle OFF for manual control")

// Get current timeframe and set optimal defaults
getOptimalSettings() =>
    tf = timeframe.period
    // M1 Settings (Ultra-fast scalping - AGGRESSIVE)
    if tf == "1"
        [5, 2, 0.6]
    // M5 Settings (Fast scalping - YOUR PREFERRED SETTINGS)
    else if tf == "5"
        [8, 2, 1.0]
    // M15 Settings (Quick trades - SCALPER OPTIMIZED)
    else if tf == "15"
        [10, 2, 1.0]
    // M30 Settings (Balanced)
    else if tf == "30"
        [12, 3, 1.2]
    // H1 and higher (Position trading)
    else if timeframe.isintraday == false or timeframe.isdaily
        [15, 4, 1.5]
    // Default (other timeframes)
    else
        [7, 2, 1.0]

[defaultLookback, defaultVolLen, defaultBoxWidth] = getOptimalSettings()

// Manual override settings (only used when autoSettings is false)
int   manualLookback = input.int(7, "Manual Lookback Period", minval=1, group = "Manual Settings",
      tooltip="SCALPER SETTINGS: M1: 5 | M5: 7 | M15: 8 | M30: 10 | H1+: 15")
int   manualVolLen   = input.int(2, "Manual Volume Filter", minval=1, group = "Manual Settings",
      tooltip = "Keep at 2 for all scalping timeframes (M1-M15)")
float manualBoxWidth = input.float(1.0, "Manual Box Width", maxval = 10, minval = 0.1, step = 0.1,
      tooltip="M1: 0.6 | M5: 1.0 | M15: 1.0 | M30: 1.2 | H1+: 1.5", group = "Manual Settings")

// Final settings (either auto or manual based on user choice)
int   lookbackPeriod = autoSettings ? defaultLookback : manualLookback
int   vol_len        = autoSettings ? defaultVolLen : manualVolLen
float box_withd      = autoSettings ? defaultBoxWidth : manualBoxWidth

// Asset-specific adjustments (Gold/XAU needs wider zones)
bool isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
float assetMultiplier = isGold ? 1.2 : 1.0
box_withd := box_withd * assetMultiplier

// ---------------------------------------------------------------------------------------------------------------------}
// 𝙈𝙊𝙑𝙄𝙉𝙂 𝘼𝙑𝙀𝙍𝘼𝙂𝙀 (𝙑𝙄𝙎𝙐𝘼𝙇 𝙎𝘼𝙅𝘼)
// ---------------------------------------------------------------------------------------------------------------------{
// ⚠️ PENTING — BACA SEBELUM MENGUBAH:
// Blok ini MURNI GAMBAR. Tidak menyentuh pivot, box, ◆ diamond, zona flip, atau alert.
// Matikan toggle-nya → chart & sinyal kembali identik dengan versi sebelumnya.
//
// KENAPA CUMA GARIS, BUKAN FILTER SINYAL?
// Diuji 13 Agu 2026 di data sendiri (XAU M5, 5.717 bar, 11 Mei–9 Jun 2026):
//   • MA cross polos (10/21 & 9/21) sebagai pemicu entry: E[R] −0.014, PF 0.98.
//     Sebelum biaya +0.046, sesudah spread $0.30 jadi negatif. Biaya > edge.
//   • MA searah sebagai GERBANG sinyal S/R: buang 93,6% sinyal, sisanya tetap rugi.
//     Sebabnya mekanis, bukan tuning — saat harga menyentuh SUPPORT, EMA10 ada di
//     BAWAH EMA21 sebanyak 97,1% kejadian (harga harus turun dulu untuk sampai ke
//     situ). Entry pantulan = beli kelemahan; MA cross = beli kekuatan. Bertentangan.
// Jadi MA di sini berguna sebagai KONTEKS MATA (arah & momentum sekilas),
// BUKAN alasan entry. Jangan sambungkan maFast/maSlow ke sig_* di bagian bawah —
// script ini sengaja tidak punya filter arah lagi sejak EMA200 dihapus (13 Agu 2026).
string grpMa    = "📈 Moving Average (visual)"
bool   maShow   = input.bool(true, "Tampilkan MA", group = grpMa,
      tooltip = "Garis bantu arah tren. TIDAK mempengaruhi sinyal ◆ sama sekali.\nMatikan → tampilan balik seperti versi lama.")
string maType   = input.string("EMA", "Tipe MA", options = ["EMA", "SMA", "WMA"], group = grpMa)
int    maFastLen = input.int(10, "MA Cepat", minval = 1, group = grpMa)
int    maSlowLen = input.int(21, "MA Lambat", minval = 1, group = grpMa)
color  maFastCol = input.color(color.new(#f39c12, 0), "Warna MA Cepat", inline = "mac", group = grpMa)
color  maSlowCol = input.color(color.new(#8e44ad, 0), "Warna MA Lambat", inline = "mac", group = grpMa)
int    maWidth   = input.int(1, "Tebal garis", minval = 1, maxval = 4, group = grpMa)
bool   maFill    = input.bool(true, "Arsir antar-MA", group = grpMa,
      tooltip = "Hijau = MA cepat di atas (momentum naik), merah = di bawah.\nMurni pewarnaan, bukan sinyal.")

// Ketiganya sengaja dihitung SETIAP bar, baru dipilih. Kalau ta.* ditaruh langsung
// di dalam cabang switch, fungsi itu tidak dipanggil tiap bar dan state internalnya
// (terutama EMA/WMA yang rekursif) bisa meleset. Ini pola aman standar Pine.
maCalc(src, len) =>
    float _e = ta.ema(src, len)
    float _s = ta.sma(src, len)
    float _w = ta.wma(src, len)
    switch maType
        "SMA" => _s
        "WMA" => _w
        => _e

float maFast = maCalc(close, maFastLen)
float maSlow = maCalc(close, maSlowLen)

plotMaFast = plot(maShow ? maFast : na, "MA Cepat",  color = maFastCol, linewidth = maWidth)
plotMaSlow = plot(maShow ? maSlow : na, "MA Lambat", color = maSlowCol, linewidth = maWidth)
// Transparansi 100 = arsir mati total (dipakai sebagai ganti `na` supaya tipe warna
// selalu jelas dan tidak bergantung pada inferensi `na`).
fill(plotMaFast, plotMaSlow,
     color = not (maShow and maFill) ? color.new(color.gray, 100)
             : maFast > maSlow       ? color.new(color.green, 88)
             :                         color.new(color.red, 88),
     title = "Arsir MA")
// ---------------------------------------------------------------------------------------------------------------------}

// Display current settings info
var table infoTable = table.new(position.top_right, 2, 4)
if barstate.islast
    currentTF = timeframe.period
    modeText = autoSettings ? "🔄 AUTO" : "🔧 MANUAL"
    assetText = isGold ? "🟨 GOLD" : "💱 " + syminfo.ticker

    // TF role in workflow: M15 = BIAS, M5 = TREND, M1 = ENTRY
    warningText = currentTF == "15" ? "① BIAS TF" : currentTF == "5" ? "② TREND TF" : currentTF == "1" ? "③ ENTRY TF" : "TF: " + currentTF
    warningColor = currentTF == "15" ? color.new(color.green, 30) : currentTF == "5" ? color.new(color.blue, 30) : currentTF == "1" ? color.new(color.purple, 30) : color.new(color.gray, 70)

    // Header
    table.cell(infoTable, 0, 0, modeText, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.cell(infoTable, 1, 0, warningText, text_color=color.white, bgcolor=warningColor, text_size=size.small)

    // Settings display
    table.cell(infoTable, 0, 1, "Lookback: " + str.tostring(lookbackPeriod), text_color=color.white, bgcolor=color.new(color.black, 80), text_size=size.tiny)
    table.cell(infoTable, 1, 1, "Vol Filter: " + str.tostring(vol_len), text_color=color.white, bgcolor=color.new(color.black, 80), text_size=size.tiny)

    // Box width and asset
    table.cell(infoTable, 0, 2, "Box: " + str.tostring(box_withd, "#.#"), text_color=color.white, bgcolor=color.new(color.black, 80), text_size=size.tiny)
    table.cell(infoTable, 1, 2, assetText, text_color=color.white, bgcolor=color.new(color.black, 80), text_size=size.tiny)

    // Trading rule reminder (M15 bias → M5 trend → M1 execution)
    ruleText = currentTF == "15" ? "FIND BIAS" : currentTF == "5" ? "CONFIRM TREND" : currentTF == "1" ? "EXECUTE HERE" : ""
    emojiText = currentTF == "15" ? "🧭" : currentTF == "5" ? "📈" : currentTF == "1" ? "🎯" : ""
    if ruleText != ""
        table.cell(infoTable, 0, 3, ruleText, text_color=color.white, bgcolor=color.new(color.purple, 70), text_size=size.tiny)
        table.cell(infoTable, 1, 3, emojiText, text_color=color.white, bgcolor=color.new(color.purple, 70), text_size=size.tiny)


// ---------------------------------------------------------------------------------------------------------------------}
// 𝙄𝙉𝘿𝙄𝘾𝘼𝙏𝙊𝙍 𝘾𝘼𝙇𝘾𝙐𝙇𝘼𝙏𝙄𝙊𝙉𝙎
// ---------------------------------------------------------------------------------------------------------------------{
// Delta Volume Function
upAndDownVolume() =>
    posVol = 0.0
    negVol = 0.0
    
    var isBuyVolume = true    

    switch
        close > open   => isBuyVolume := true
        close < open   => isBuyVolume := false

    if isBuyVolume
        posVol += volume
    else
        negVol -= volume

    posVol + negVol


// Function to identify support and resistance boxes
calcSupportResistance(src, lookbackPeriod) =>
    // Volume
    Vol    = upAndDownVolume()
    vol_hi = ta.highest(Vol/2.5, vol_len)
    vol_lo = ta.lowest(Vol/2.5, vol_len)

    var float supportLevel      = na
    var float supportLevel_1    = na    
    var float resistanceLevel   = na
    var float resistanceLevel_1 = na    
    var box   sup               = na
    var box   res               = na
    var color res_color         = na
    var color sup_color         = na    
    var float multi             = na

    var bool  brekout_res       = na
    var bool  brekout_sup       = na
    var bool  res_holds         = na
    var bool  sup_holds         = na

    // Find pivot points
    pivotHigh = ta.pivothigh(src, lookbackPeriod, lookbackPeriod)
    pivotLow  = ta.pivotlow (src, lookbackPeriod, lookbackPeriod)
    // Box width
    atr       = ta.atr(200)
    withd     = atr * box_withd

    // Find support levels with Positive Volume
    if (not na(pivotLow)) and Vol > vol_hi 

        supportLevel   := pivotLow
        supportLevel_1 := supportLevel-withd       

        topLeft         = chart.point.from_index(bar_index-lookbackPeriod, supportLevel)
        bottomRight     = chart.point.from_index(bar_index, supportLevel_1)

        sup_color      := color.from_gradient(Vol, 0, ta.highest(Vol, 25), color(na), color.new(color.green, 30))

        sup := box.new(
                       top_left     = topLeft, 
                       bottom_right = bottomRight, 
                       border_color = color.green, 
                       border_width = 1, 
                       bgcolor      = sup_color, 
                       text         = "Vol: "+str.tostring(math.round(Vol,2)), 
                       text_color   = chart.fg_color, 
                       text_size    = size.small
                       ) 


    // Find resistance levels with Negative Volume
    if (not na(pivotHigh)) and Vol < vol_lo
   
        resistanceLevel   := pivotHigh
        resistanceLevel_1 := resistanceLevel+withd

        topLeft            = chart.point.from_index(bar_index-lookbackPeriod, resistanceLevel)
        bottomRight        = chart.point.from_index(bar_index, resistanceLevel_1)

        res_color         := color.from_gradient(Vol, ta.lowest(Vol, 25), 0, color.new(color.red, 30), color(na))

        res := box.new(
                       top_left     = topLeft, 
                       bottom_right = bottomRight, 
                       border_color = color.red, 
                       border_width = 1, 
                       bgcolor      = res_color, 
                       text         = "Vol: "+str.tostring(math.round(Vol,2)), 
                       text_color   = chart.fg_color, 
                       text_size    = size.small
                       ) 

    // Adaptive Box Len
    sup.set_right(bar_index+1)
    res.set_right(bar_index+1)

    // Break of support or resistance conditions
    brekout_res := ta.crossover(low, resistanceLevel_1)
    res_holds   := ta.crossunder(high, resistanceLevel)

    sup_holds   := ta.crossover(low, supportLevel)
    brekout_sup := ta.crossunder(high, supportLevel_1)

    // Change Color of Support to ORANGE if it was break (SBR - Support Became Resistance)
    if brekout_sup
        sup.set_bgcolor(color.new(color.orange, 80))
        sup.set_border_color(color.orange)
        sup.set_border_style(line.style_dashed)

    if sup_holds
        sup.set_bgcolor(sup_color)
        sup.set_border_color(color.green)
        sup.set_border_style(line.style_solid)

    // Change color of resistance to ORANGE if it was break (RBS - Resistance Became Support)
    if brekout_res
        res.set_bgcolor(color.new(color.orange, 80))
        res.set_border_color(color.orange)
        res.set_border_style(line.style_dashed)

    if res_holds
        res.set_bgcolor(res_color)
        res.set_border_color(color.new(color.red, 0))
        res.set_border_style(line.style_solid)

    [supportLevel, resistanceLevel, brekout_res, res_holds, sup_holds, brekout_sup]


// Calculate support and resistance levels and their breakouts
[supportLevel,
         resistanceLevel, 
             brekout_res, 
                 res_holds, 
                     sup_holds, 
                         brekout_sup] = calcSupportResistance(close, lookbackPeriod)


// Check if Resistance become Support or Support Become Resistance
var bool res_is_sup = na
var bool sup_is_res = na

switch
    brekout_res => res_is_sup := true
    res_holds   => res_is_sup := false

switch
    brekout_sup => sup_is_res := true
    sup_holds   => sup_is_res := false


// ---------------------------------------------------------------------------------------------------------------------}
// 𝙑𝙄𝙎𝙐𝘼𝙇𝙄𝙕𝘼𝙏𝙄𝙊𝙉
// ---------------------------------------------------------------------------------------------------------------------{
// Sinyal ◆ TANPA filter bias apa pun — murni dari struktur S/R (pivot + volume delta).
// Filter EMA200 dihapus 13 Agu 2026 atas keputusan user (tidak membantu di trading live;
// backtest juga menunjukkannya netral, bukan positif). Arah/bias sekarang dibaca manual
// lewat top-down M15→M5→M1, bukan dipaksakan oleh script.
bool sig_res_holds = res_holds
bool sig_sup_holds = sup_holds
bool sig_rbs_buy   = res_is_sup and ta.crossover(low, resistanceLevel)
bool sig_sbr_sell  = sup_is_res and ta.crossunder(high, supportLevel)

// Plot Res and Sup breakouts and holds
plotchar(sig_res_holds, "Resistance Holds", "◆", color=#e92929, size=size.tiny, location=location.abovebar, offset=-1)
plotchar(sig_sup_holds, "Support Holds", "◆", color=#20ca26, size=size.tiny, location=location.belowbar, offset=-1)

// RETEST SIGNALS - Diamond appears when price retests broken level
// RBS: Resistance broken (became support) → price pulls back → bounces from old resistance (now support)
plotchar(sig_rbs_buy, "RBS Retest - BUY", "◆", color=#20ca26, size=size.tiny, location=location.belowbar, offset=-1)

// SBR: Support broken (became resistance) → price pulls back → rejected from old support (now resistance)
plotchar(sig_sbr_sell, "SBR Retest - SELL", "◆", color=#e92929, size=size.tiny, location=location.abovebar, offset=-1)

// Break Out Labels (SBR/RBS with Orange)
if brekout_sup and not sup_is_res[1]
    label.new(bar_index[1], supportLevel[1], text="SBR ⚠", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small, tooltip="Support Became Resistance")

if brekout_res and not res_is_sup[1]
    label.new(bar_index[1], resistanceLevel[1], text="RBS ⚠", style=label.style_label_up, color=color.orange, textcolor=color.white, size=size.small, tooltip="Resistance Became Support")

// ---------------------------------------------------------------------------------------------------------------------}
// 𝘼𝙇𝙀𝙍𝙏𝙎 & 𝙏𝙍𝘼𝘿𝙄𝙉𝙂 𝙎𝙄𝙂𝙉𝘼𝙇𝙎
// ---------------------------------------------------------------------------------------------------------------------{

// Get current timeframe for alert messages
tf_text = timeframe.period

// BREAK & RETEST ALERTS (Most important for scalping)
alertcondition(sig_rbs_buy, title="🟢 RBS RETEST - BUY", message="🎯 [{{ticker}}] {{interval}} | RBS RETEST BUY\n💹 Entry: {{close}}\n⏰ Time: {{time}}\n📊 Old Resistance → Now Support\n🧭 Cek bias M15 dulu — sinyal ini TIDAK difilter arah\n✅ HIGH PROBABILITY SETUP")

alertcondition(sig_sbr_sell, title="🔴 SBR RETEST - SELL",message="🎯 [{{ticker}}] {{interval}} | SBR RETEST SELL\n📉 Entry: {{close}}\n⏰ Time: {{time}}\n📊 Old Support → Now Resistance\n🧭 Cek bias M15 dulu — sinyal ini TIDAK difilter arah\n✅ HIGH PROBABILITY SETUP")

// First Touch Alerts
alertcondition(sig_res_holds, title="🔴 Resistance Touch", message="⚠️ [{{ticker}}] {{interval}} | RESISTANCE TOUCH\n📉 Level: {{close}}\n⏰ Time: {{time}}\n📊 Watch for rejection candle\n⚡ Quick scalp opportunity")

alertcondition(sig_sup_holds, title="🟢 Support Touch", message="⚠️ [{{ticker}}] {{interval}} | SUPPORT TOUCH\n💹 Level: {{close}}\n⏰ Time: {{time}}\n📊 Watch for bounce candle\n⚡ Quick scalp opportunity")

// Breakout Alerts (Wait for retest!)
alertcondition(brekout_res, title="⬆️ Resistance Break", message="🚨 [{{ticker}}] {{interval}} | RESISTANCE BROKEN\n📈 Price: {{close}}\n⏰ Time: {{time}}\n⏳ WAIT for pullback & retest\n🎯 Potential RBS setup coming")

alertcondition(brekout_sup, title="⬇️ Support Break", message="🚨 [{{ticker}}] {{interval}} | SUPPORT BROKEN\n📉 Price: {{close}}\n⏰ Time: {{time}}\n⏳ WAIT for pullback & retest\n🎯 Potential SBR setup coming")

// ◆
// ---------------------------------------------------------------------------------------------------------------------}


// ---------------------------------------------------------------------------------------------------------------------}
// 𝙇𝙄𝙌𝙐𝙄𝘿𝙄𝙏𝙔 𝙎𝙒𝙄𝙉𝙂𝙎  (© LuxAlgo — CC BY-NC-SA 4.0)
// ---------------------------------------------------------------------------------------------------------------------{
// Menandai swing high/low sebagai zona LIKUIDITAS (kumpulan stop order retail).
// Angka pada label = volume yang tertahan di area itu → makin besar = makin banyak
// likuiditas → makin "menggoda" institusi untuk sweep. Level jadi GARIS PUTUS saat
// harga menembusnya (likuiditas ter-grab).
//
// 🔗 CARA PAKAI BARENG S/R (confluence scalping):
//   • Swing high (garis merah) nemplok di zona RESISTANCE box → area jual kuat / target sweep.
//   • Swing low (garis teal) nemplok di zona SUPPORT box       → area beli kuat / target sweep.
//   • Setelah likuiditas di-sweep (garis jadi putus) lalu balik ke S/R → itu jebakan
//     (stop hunt) → cari sinyal ◆ untuk entry lawan arah sweep.
//
// ⚠️ Intrabar Precision default OFF — plan TradingView FREE tidak support LTF, biarkan mati.

string grpLiq = "💧 Liquidity Swings (LuxAlgo)"

bool   liqEnable      = input.bool(true, "Enable Liquidity Swings", group = grpLiq, tooltip = "Master switch. Matikan kalau chart terlalu ramai atau mau pakai S/R saja.")

// AUTO-ADJUST lookback liquidity per timeframe (mirror sistem S/R).
// Angkanya sedikit lebih besar dari S/R karena likuiditas = swing yang BENAR-BENAR signifikan
// (kolam stop order), bukan swing kecil. Makin besar TF → makin besar lookback → pool makin mayor.
bool   liqAutoLength  = input.bool(true, "🔄 Auto-Adjust Lookback by Timeframe", group = grpLiq, tooltip = "✅ AUTO: lookback nyesuaiin TF\n• M1: 8\n• M5: 12\n• M15: 14\n• M30: 16\n• H1+: 20\n\nMatikan untuk pakai 'Manual Pivot Lookback' di bawah.")
int    liqLengthManual = input.int(14, 'Manual Pivot Lookback', minval = 1, group = grpLiq, tooltip = "Hanya dipakai saat Auto-Adjust OFF.")

getOptimalLiqLength() =>
    tf = timeframe.period
    if tf == "1"
        8
    else if tf == "5"
        12
    else if tf == "15"
        14
    else if tf == "30"
        16
    else if timeframe.isintraday == false or timeframe.isdaily
        20
    else if tf == "60" or tf == "120" or tf == "240"
        20
    else
        14

int    liqLength      = liqAutoLength ? getOptimalLiqLength() : liqLengthManual
string liqArea        = input.string('Wick Extremity', 'Swing Area', options = ['Wick Extremity', 'Full Range'], group = grpLiq)

bool   liqIntraPrecision = input.bool(false, 'Intrabar Precision', inline = 'liqintra', group = grpLiq, tooltip = "⚠️ Butuh plan berbayar (akses LTF). Di plan FREE biarkan OFF.")
string liqIntrabarTf     = input.timeframe('1', ''                , inline = 'liqintra', group = grpLiq)

string liqFilterOptions = input.string('Count', 'Filter Areas By', options = ['Count', 'Volume'], inline = 'liqfilter', group = grpLiq)
float  liqFilterValue   = input.float(0, ''                                                     , inline = 'liqfilter', group = grpLiq)

bool   liqShowTop     = input.bool(true, 'Swing High'              , inline = 'liqtop', group = grpLiq)
color  liqTopCss      = input.color(color.red, ''                  , inline = 'liqtop', group = grpLiq)
color  liqTopAreaCss  = input.color(color.new(color.red, 50), 'Area', inline = 'liqtop', group = grpLiq)

bool   liqShowBtm     = input.bool(true, 'Swing Low'                , inline = 'liqbtm', group = grpLiq)
color  liqBtmCss      = input.color(color.teal, ''                  , inline = 'liqbtm', group = grpLiq)
color  liqBtmAreaCss  = input.color(color.new(color.teal, 50), 'Area', inline = 'liqbtm', group = grpLiq)

string liqLabelSize   = input.string('Tiny', 'Labels Size', options = ['Tiny', 'Small', 'Normal'], group = grpLiq)

// Master toggle digabung dengan toggle per-sisi
bool liqTop = liqShowTop and liqEnable
bool liqBtm = liqShowBtm and liqEnable

//----- Functions -----
liq_n = bar_index

liq_get_data()=> [high, low, volume]
[liq_h, liq_l, liq_v] = request.security_lower_tf(syminfo.tickerid, liqIntrabarTf, liq_get_data())

liq_get_counts(condition, top, btm)=>
    var count = 0
    var vol = 0.

    if condition
        count := 0
        vol := 0.
    else
        if liqIntraPrecision
            if liq_n > liqLength
                if array.size(liq_v[liqLength]) > 0
                    for [index, element] in liq_v[liqLength]
                        vol += array.get(liq_l[liqLength], index) < top and array.get(liq_h[liqLength], index) > btm ? element : 0
        else
            vol += low[liqLength] < top and high[liqLength] > btm ? volume[liqLength] : 0

        count += low[liqLength] < top and high[liqLength] > btm ? 1 : 0

    [count, vol]

liq_set_label(count, vol, x, y, css, lbl_style)=>
    var label lbl = na
    var label_size = switch liqLabelSize
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal

    target = switch liqFilterOptions
        'Count'  => count
        'Volume' => vol

    if ta.crossover(target, liqFilterValue)
        lbl := label.new(x, y, str.tostring(vol, format.volume)
          , style = lbl_style
          , size = label_size
          , color = #00000000
          , textcolor = css)

    if target > liqFilterValue
        label.set_text(lbl, str.tostring(vol, format.volume))

liq_set_level(condition, crossed, value, count, vol, css)=>
    var line lvl = na

    target = switch liqFilterOptions
        'Count'  => count
        'Volume' => vol

    if condition
        if target[1] < liqFilterValue[1]
            line.delete(lvl[1])
        else if not crossed[1]
            line.set_x2(lvl, liq_n - liqLength)

        lvl := line.new(liq_n - liqLength, value, liq_n, value
          , color = na)

    if not crossed[1]
        line.set_x2(lvl, liq_n+3)

    if crossed and not crossed[1]
        line.set_x2(lvl, liq_n)
        line.set_style(lvl, line.style_dashed)

    if target > liqFilterValue
        line.set_color(lvl, css)

liq_set_zone(condition, x, top, btm, count, vol, css)=>
    var box bx = na

    target = switch liqFilterOptions
        'Count'  => count
        'Volume' => vol

    if ta.crossover(target, liqFilterValue)
        bx := box.new(x, top, x + count, btm
          , border_color = na
          , bgcolor = css)

    if target > liqFilterValue
        box.set_right(bx, x + count)

//----- Global variables -----
//Pivot high
var float liq_ph_top = na
var float liq_ph_btm = na
var bool  liq_ph_crossed = na
var       liq_ph_x1 = 0
var box   liq_ph_bx = box.new(na,na,na,na
  , bgcolor = color.new(liqTopAreaCss, 80)
  , border_color = na)

//Pivot low
var float liq_pl_top = na
var float liq_pl_btm = na
var bool  liq_pl_crossed = na
var       liq_pl_x1 = 0
var box   liq_pl_bx = box.new(na,na,na,na
  , bgcolor = color.new(liqBtmAreaCss, 80)
  , border_color = na)

//----- Display pivot high levels/blocks -----
liq_ph = ta.pivothigh(liqLength, liqLength)

[liq_ph_count, liq_ph_vol] = liq_get_counts(liq_ph, liq_ph_top, liq_ph_btm)

if liq_ph and liqTop
    liq_ph_top := high[liqLength]
    liq_ph_btm := switch liqArea
        'Wick Extremity' => math.max(close[liqLength], open[liqLength])
        'Full Range' => low[liqLength]

    liq_ph_x1 := liq_n - liqLength
    liq_ph_crossed := false

    box.set_lefttop(liq_ph_bx, liq_ph_x1, liq_ph_top)
    box.set_rightbottom(liq_ph_bx, liq_ph_x1, liq_ph_btm)
else
    liq_ph_crossed := close > liq_ph_top ? true : liq_ph_crossed

    if liq_ph_crossed
        box.set_right(liq_ph_bx, liq_ph_x1)
    else
        box.set_right(liq_ph_bx, liq_n+3)

if liqTop
    liq_set_zone(liq_ph, liq_ph_x1, liq_ph_top, liq_ph_btm, liq_ph_count, liq_ph_vol, liqTopAreaCss)
    liq_set_level(liq_ph, liq_ph_crossed, liq_ph_top, liq_ph_count, liq_ph_vol, liqTopCss)
    liq_set_label(liq_ph_count, liq_ph_vol, liq_ph_x1, liq_ph_top, liqTopCss, label.style_label_down)

//----- Display pivot low levels/blocks -----
liq_pl = ta.pivotlow(liqLength, liqLength)

[liq_pl_count, liq_pl_vol] = liq_get_counts(liq_pl, liq_pl_top, liq_pl_btm)

if liq_pl and liqBtm
    liq_pl_top := switch liqArea
        'Wick Extremity' => math.min(close[liqLength], open[liqLength])
        'Full Range' => high[liqLength]
    liq_pl_btm := low[liqLength]

    liq_pl_x1 := liq_n - liqLength
    liq_pl_crossed := false

    box.set_lefttop(liq_pl_bx, liq_pl_x1, liq_pl_top)
    box.set_rightbottom(liq_pl_bx, liq_pl_x1, liq_pl_btm)
else
    liq_pl_crossed := close < liq_pl_btm ? true : liq_pl_crossed

    if liq_pl_crossed
        box.set_right(liq_pl_bx, liq_pl_x1)
    else
        box.set_right(liq_pl_bx, liq_n+3)

if liqBtm
    liq_set_zone(liq_pl, liq_pl_x1, liq_pl_top, liq_pl_btm, liq_pl_count, liq_pl_vol, liqBtmAreaCss)
    liq_set_level(liq_pl, liq_pl_crossed, liq_pl_btm, liq_pl_count, liq_pl_vol, liqBtmCss)
    liq_set_label(liq_pl_count, liq_pl_vol, liq_pl_x1, liq_pl_btm, liqBtmCss, label.style_label_up)

// ---------------------------------------------------------------------------------------------------------------------}
